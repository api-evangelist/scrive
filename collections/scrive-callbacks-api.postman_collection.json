          "name": "Trigger a manual callback",
          "request": {
            "name": "Trigger a manual callback",
            "description": {
              "content": "Triggers a callback (HTTP POST) to the document's configured api_callback_url. Scrive also automatically POSTs a callback when a document changes to pending, closed, canceled, timedout, or rejected, retrying failed deliveries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "documents",
                ":document_id",
                "callback"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "document_id",
                  "description": "(Required) "
                }
              ]
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
